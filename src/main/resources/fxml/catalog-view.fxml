<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="800.0" prefWidth="1100.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="velmora.composer.ui.controller.CatalogController"
           styleClass="catalog-root">

  <AnchorPane StackPane.alignment="TOP_LEFT">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          spacing="0.0">

      <VBox style="-fx-padding: 28 48 12 48;" spacing="4.0">
        <HBox spacing="12.0" alignment="CENTER_LEFT">
          <Rectangle width="3.0" height="22.0" fill="#b18db8" arcWidth="2" arcHeight="2" />
          <Label fx:id="headerTitle" text="Perfume Catalog" styleClass="catalog-heading" />
          <Region HBox.hgrow="ALWAYS" />
          <Label fx:id="catalogCount" text="0 fragrances" styleClass="catalog-subtitle" />
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
          <Button text="←  Back to Composer" onAction="#handleBack" styleClass="btn-ghost-lux" />
          <Button text="⟳ Refresh" onAction="#refreshRecommendations" styleClass="filter-btn"
                  style="-fx-font-size: 14; -fx-padding: 4 12;" />

          <Rectangle width="1.0" height="20.0" fill="rgba(177,141,184,0.15)" arcWidth="1" arcHeight="1" />

          <Label text="BRAND" style=" -fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <ComboBox fx:id="brandFilter" promptText="All" prefWidth="110"
                    style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #E2DDD4; -fx-border-radius: 6; -fx-font-size: 15;" />

          <Label text="FAMILY" style=" -fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <ComboBox fx:id="familyFilter" promptText="All" prefWidth="110"
                    style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #E2DDD4; -fx-border-radius: 6; -fx-font-size: 15;" />

          <Label text="STYLE" style=" -fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <ComboBox fx:id="styleFilter" promptText="All" prefWidth="120"
                    style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #E2DDD4; -fx-border-radius: 6; -fx-font-size: 15;" />

          <Label text="LONGEVITY" style=" -fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <ComboBox fx:id="longevityFilter" promptText="All" prefWidth="130"
                    style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #E2DDD4; -fx-border-radius: 6; -fx-font-size: 15;" />
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
          <TextField fx:id="searchField" promptText="Search perfumes..."
                     styleClass="catalog-search" prefWidth="240.0" />
          <Region HBox.hgrow="ALWAYS" />
          <Label text="MIN SIMILARITY" style=" -fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <Slider fx:id="similaritySlider" min="0" max="100" value="0"
                  prefWidth="120" showTickLabels="false" showTickMarks="false"
                  styleClass="vault-slider" />
          <Label fx:id="similarityLabel" text="0%+" style="-fx-font-size: 16; -fx-font-weight: 700; -fx-text-fill: #b18db8; -fx-min-width: 40;" />
        </HBox>
      </VBox>

      <Rectangle height="1.0" style="-fx-fill: rgba(221,217,209,0.4);"
                 AnchorPane.leftAnchor="48.0" AnchorPane.rightAnchor="48.0" />

      <VBox fx:id="emptyState" visible="false" managed="false"
            alignment="CENTER" VBox.vgrow="ALWAYS"
            style="-fx-padding: 80 40;">
        <Label fx:id="emptyTitle" text="Create a composition first"
               style="-fx-font-family: 'Libre Baskerville', serif; -fx-font-size: 28; -fx-text-fill: #B0ADA8; -fx-font-weight: 600;" />
        <Label fx:id="emptySubtitle" text="Build your formula in the Composer to discover similar perfumes."
               style="-fx-font-size: 18; -fx-text-fill: #C4BFB9; -fx-font-style: italic; -fx-padding: 8 0 0 0;" />
      </VBox>

      <VBox fx:id="mainContent" VBox.vgrow="ALWAYS">
        <ScrollPane fx:id="gridScroll" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-padding: 0;"
                    styleClass="thin-scroll">
          <FlowPane fx:id="catalogGrid" hgap="16.0" vgap="16.0"
                    style="-fx-padding: 24 48 48 48;"
                    alignment="TOP_LEFT" />
        </ScrollPane>
      </VBox>
    </VBox>
  </AnchorPane>

  <StackPane fx:id="modalOverlay" visible="false" managed="false"
             styleClass="modal-overlay" StackPane.alignment="CENTER">
    <VBox fx:id="modalContent" maxWidth="580.0" maxHeight="760.0"
          styleClass="modal-glass" spacing="8.0"
          style="-fx-padding: 20 24 20 24;">
    </VBox>
  </StackPane>

</StackPane>
