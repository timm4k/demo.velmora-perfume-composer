<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="800.0" prefWidth="1100.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="velmora.composer.ui.controller.CommunityController"
           styleClass="catalog-root">

  <AnchorPane StackPane.alignment="TOP_LEFT">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          spacing="0.0">

      <VBox style="-fx-padding: 28 48 12 48;" spacing="4.0">
        <HBox spacing="12.0" alignment="CENTER_LEFT">
          <Rectangle width="3.0" height="22.0" fill="#b18db8" arcWidth="2" arcHeight="2" />
          <Label text="Community Formulas" styleClass="catalog-heading" />
          <Region HBox.hgrow="ALWAYS" />
          <Label fx:id="communityCount" text="0 formulas" styleClass="catalog-subtitle" />
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
          <Button text="\u2190  Back to Catalog" onAction="#handleBack" styleClass="btn-ghost-lux" />
          <Rectangle width="1.0" height="20.0" fill="rgba(177,141,184,0.15)" arcWidth="1" arcHeight="1" />
          <Button text="\u21BB Refresh" onAction="#handleRefresh" styleClass="filter-btn"
                  style="-fx-font-size: 14; -fx-padding: 4 12;" />
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
          <TextField fx:id="searchField" promptText="Search formulas..."
                     styleClass="catalog-search" prefWidth="200.0" />
          <Label text="FAMILY" style="-fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <ComboBox fx:id="familyFilter" promptText="All" prefWidth="120"
                    style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #E2DDD4; -fx-border-radius: 6; -fx-font-size: 15;" />
          <Label text="AUTHOR" style="-fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <TextField fx:id="authorField" promptText="Any" prefWidth="120"
                     style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #E2DDD4; -fx-border-radius: 6; -fx-font-size: 15; -fx-padding: 4 8;" />
          <Label text="MIN HARMONY" style="-fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <Slider fx:id="harmonySlider" min="0" max="100" value="0"
                  prefWidth="100" showTickLabels="false" showTickMarks="false"
                  styleClass="vault-slider" />
          <Label fx:id="harmonyLabel" text="0%+" style="-fx-font-size: 16; -fx-font-weight: 700; -fx-text-fill: #b18db8; -fx-min-width: 40;" />
          <Label text="DATE" style="-fx-font-size: 14; -fx-font-weight: 700; -fx-text-fill: #B0ADA8; -fx-letter-spacing: 1.5;" />
          <ComboBox fx:id="dateFilter" promptText="All Time" prefWidth="120"
                    style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #E2DDD4; -fx-border-radius: 6; -fx-font-size: 15;" />
        </HBox>
      </VBox>

      <Rectangle height="1.0" style="-fx-fill: rgba(221,217,209,0.4);"
                 AnchorPane.leftAnchor="48.0" AnchorPane.rightAnchor="48.0" />

      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-padding: 0;"
                  styleClass="thin-scroll">
        <FlowPane fx:id="communityGrid" hgap="14.0" vgap="14.0"
                  style="-fx-padding: 24 48 48 48;"
                  alignment="TOP_LEFT" />
      </ScrollPane>
    </VBox>
  </AnchorPane>

  <StackPane fx:id="detailOverlay" visible="false" managed="false"
             styleClass="modal-overlay" StackPane.alignment="CENTER">
    <VBox fx:id="detailContent" maxWidth="580.0" maxHeight="760.0"
          styleClass="modal-glass" spacing="8.0"
          style="-fx-padding: 20 24 20 24;">
    </VBox>
  </StackPane>

</StackPane>