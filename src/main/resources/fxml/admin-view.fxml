<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="800.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="velmora.composer.ui.controller.AdminController"
  styleClass="vault-root">

  <AnchorPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
    <children>
      <VBox AnchorPane.leftAnchor="44.0" AnchorPane.topAnchor="36.0" spacing="4.0">
        <Label text="Admin Panel" styleClass="font-serif text-4xl text-primary" />
        <Rectangle width="50.0" height="2.0" fill="#b18db8" arcWidth="2" arcHeight="2" />
        <Label text="NOTE DATABASE MANAGEMENT" styleClass="text-xs tracking-3 text-purple" />
      </VBox>

      <Label fx:id="adminMessage"
        AnchorPane.leftAnchor="44.0" AnchorPane.topAnchor="100.0"
        styleClass="text-base font-bold text-error" />

      <VBox AnchorPane.leftAnchor="44.0" AnchorPane.rightAnchor="44.0"
        AnchorPane.topAnchor="120.0" AnchorPane.bottomAnchor="24.0" spacing="16.0">

        <HBox spacing="12.0" alignment="CENTER_LEFT">
          <Label text="ALL NOTES" styleClass="text-base font-bold text-secondary tracking-2" />
          <Label fx:id="notesCount" text="0"
            style="-fx-background-color: rgba(177,141,184,0.2); -fx-background-radius: 4;
                   -fx-padding: 2 10; -fx-text-fill: #b18db8; -fx-font-size: 18; -fx-font-weight: bold;" />
          <Region HBox.hgrow="ALWAYS" />
          <Button text="+ ADD NOTE" onAction="#handleAdd" styleClass="btn btn-teal" />
          <Button text="EDIT" onAction="#handleEdit" styleClass="btn btn-primary" />
          <Button text="DELETE" onAction="#handleDelete" styleClass="btn btn-danger" />
        </HBox>

        <ListView fx:id="notesList" VBox.vgrow="ALWAYS"
          style="-fx-background-radius: 8; -fx-border-color: #DDD9D1; -fx-border-radius: 8;" />

        <VBox fx:id="editorPanel" spacing="12.0" styleClass="card"
          style="-fx-padding: 24;">
          <Label fx:id="editorTitle" text="NOTE" styleClass="text-md font-bold text-primary" />

          <HBox spacing="16.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
              <Label text="NAME" styleClass="form-label" />
              <TextField fx:id="editName" promptText="Note name" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
              <Label text="COLOR CODE" styleClass="form-label" />
              <TextField fx:id="editColor" promptText="#HEX" />
            </VBox>
          </HBox>

          <HBox spacing="16.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
              <Label text="CATEGORY" styleClass="form-label" />
              <ComboBox fx:id="editCategory" promptText="Select category" prefWidth="Infinity" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
              <Label text="TYPE" styleClass="form-label" />
              <ComboBox fx:id="editType" promptText="TOP / HEART / BASE" prefWidth="Infinity" />
            </VBox>
            <VBox spacing="4.0">
              <Label text="INTENSITY" styleClass="form-label" />
              <Spinner fx:id="editIntensity" prefWidth="80" />
            </VBox>
          </HBox>

          <VBox spacing="4.0">
            <Label text="DESCRIPTION" styleClass="form-label" />
            <TextArea fx:id="editDescription" promptText="Note description" prefRowCount="3" />
          </VBox>

          <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <Button text="CANCEL" onAction="#handleCancel" styleClass="btn-ghost" />
            <Button text="SAVE NOTE" onAction="#handleSaveNote" styleClass="btn btn-teal" />
          </HBox>
        </VBox>
      </VBox>
    </children>
  </AnchorPane>
</AnchorPane>
