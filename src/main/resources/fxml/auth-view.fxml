<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="auth-root" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="velmora.composer.ui.controller.AuthController">
  <children>
    <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="0">
      <StackPane prefHeight="300.0" maxWidth="Infinity" styleClass="auth-brand-bg">
        <VBox alignment="CENTER" spacing="8">
          <Label text="VELMORA" styleClass="auth-brand" />
          <Label text="OLFACTORY LABORATORY" styleClass="auth-subtitle" />
          <Label text="Compose. Analyze. Create." styleClass="auth-tagline" />
        </VBox>
      </StackPane>

      <AnchorPane fx:id="authCard" styleClass="auth-card" prefWidth="420.0" maxWidth="420.0" prefHeight="440.0" translateY="-40.0">
        <children>
          <VBox fx:id="loginForm" spacing="20.0" AnchorPane.topAnchor="36.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0">
            <Label text="WELCOME BACK" styleClass="auth-form-title" />
            <VBox spacing="4.0">
              <Label text="EMAIL" styleClass="field-label" />
              <TextField fx:id="loginEmail" promptText="Enter your email" />
            </VBox>
            <VBox spacing="4.0">
              <Label text="PASSWORD" styleClass="field-label" />
              <PasswordField fx:id="loginPassword" promptText="Enter your password" />
            </VBox>
            <Label fx:id="loginError" styleClass="auth-error" managed="false" visible="false" wrapText="true" />
            <Button text="SIGN IN" onAction="#handleLogin" styleClass="btn-primary" maxWidth="Infinity" />
            <HBox alignment="CENTER" spacing="4.0">
              <Label text="Don't have an account?" styleClass="auth-switch-text" />
              <Hyperlink text="Create one" onAction="#switchToRegister" styleClass="auth-switch-link" />
            </HBox>
          </VBox>

          <VBox fx:id="registerForm" spacing="20.0" AnchorPane.topAnchor="36.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" managed="false" visible="false">
            <Label text="CREATE ACCOUNT" styleClass="auth-form-title" />
            <VBox spacing="4.0">
              <Label text="NICKNAME" styleClass="field-label" />
              <TextField fx:id="regNickname" promptText="Choose a nickname" />
            </VBox>
            <VBox spacing="4.0">
              <Label text="EMAIL" styleClass="field-label" />
              <TextField fx:id="regEmail" promptText="Enter your email" />
            </VBox>
            <VBox spacing="4.0">
              <Label text="PASSWORD" styleClass="field-label" />
              <PasswordField fx:id="regPassword" promptText="At least 6 characters" />
            </VBox>
            <Label fx:id="regError" styleClass="auth-error" managed="false" visible="false" wrapText="true" />
            <Button text="CREATE ACCOUNT" onAction="#handleRegister" styleClass="btn-primary" maxWidth="Infinity" />
            <HBox alignment="CENTER" spacing="4.0">
              <Label text="Already have an account?" styleClass="auth-switch-text" />
              <Hyperlink text="Sign in" onAction="#switchToLogin" styleClass="auth-switch-link" />
            </HBox>
          </VBox>

          <VBox fx:id="verifyForm" spacing="20.0" AnchorPane.topAnchor="36.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" managed="false" visible="false">
            <Label text="VERIFY YOUR EMAIL" styleClass="auth-form-title" />
            <Label fx:id="verifyInfoText" text="Enter the code sent to your email" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #888;" />
            <VBox spacing="4.0">
              <Label text="VERIFICATION CODE" styleClass="field-label" />
              <TextField fx:id="verifyCode" promptText="000000" alignment="CENTER" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-letter-spacing: 12;" />
            </VBox>
            <Label fx:id="verifyError" styleClass="auth-error" managed="false" visible="false" wrapText="true" />
            <Button text="VERIFY" onAction="#handleVerify" styleClass="btn-primary" maxWidth="Infinity" />
            <HBox alignment="CENTER" spacing="4.0">
              <Label text="Back to" styleClass="auth-switch-text" />
              <Hyperlink text="Sign in" onAction="#switchToLogin" styleClass="auth-switch-link" />
            </HBox>
          </VBox>
        </children>
      </AnchorPane>
    </VBox>
  </children>
</StackPane>
