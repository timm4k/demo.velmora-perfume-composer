<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="velmora.composer.ui.controller.AuthController"
  styleClass="auth-root"
  prefHeight="800.0" prefWidth="1200.0">

  <StackPane prefWidth="500.0" HBox.hgrow="NEVER"
    style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #EDE9E0 0%, #E5DFD4 60%, #DDD7CB 100%);">

    <Circle radius="260.0" layoutX="80.0" layoutY="180.0" styleClass="deco-glow-purple" />
    <Circle radius="200.0" layoutX="450.0" layoutY="560.0" styleClass="deco-glow-peach" />
    <Circle radius="160.0" layoutX="250.0" layoutY="700.0" styleClass="deco-glow-teal" />

    <Rectangle width="1.0" height="120.0" translateX="-180.0" translateY="-160.0" fill="#b18db8" opacity="0.3" />
    <Rectangle width="1.0" height="80.0" translateX="-180.0" translateY="200.0" fill="#E2A998" opacity="0.3" />

    <VBox alignment="CENTER" spacing="0">
      <HBox spacing="10.0" alignment="CENTER" style="-fx-padding: 0 0 28 0;">
        <Rectangle width="28.0" height="1.0" fill="#b18db8" opacity="0.6" />
        <Label text="EST. MMXXIV" style=" -fx-font-size: 16; -fx-letter-spacing: 4; -fx-text-fill: #b18db8;" />
        <Rectangle width="28.0" height="1.0" fill="#b18db8" opacity="0.6" />
      </HBox>

      <Label text="VELMORA" styleClass="auth-brand" />

      <HBox spacing="10.0" alignment="CENTER" style="-fx-padding: 16 0 16 0;">
        <Rectangle width="36.0" height="1.0" fill="#E2A998" opacity="0.7" />
        <Circle radius="2.0" fill="#E2A998" opacity="0.7" />
        <Circle radius="3.5" fill="#b18db8" opacity="0.6" />
        <Circle radius="2.0" fill="#E2A998" opacity="0.7" />
        <Rectangle width="36.0" height="1.0" fill="#E2A998" opacity="0.7" />
      </HBox>

      <Label text="OLFACTORY LABORATORY" styleClass="auth-subtitle" />
      <Label text="Compose. Analyze. Create." styleClass="auth-tagline" style="-fx-padding: 10 0 0 0;" />

      <VBox spacing="8.0" alignment="CENTER" style="-fx-padding: 60 0 0 0;">
        <Rectangle width="1.0" height="60.0" fill="#78A0A0" opacity="0.35" />
        <Circle radius="3.0" styleClass="deco-dot-teal" />
      </VBox>

      <Label text="&quot;Where science meets scent.&quot;"
        style=" -fx-font-size: 18; -fx-font-style: italic; -fx-text-fill: #A0968C; -fx-padding: 24 40 0 40;"
        wrapText="true" alignment="CENTER" />
    </VBox>

    <VBox alignment="BOTTOM_LEFT" style="-fx-padding: 32;">
      <HBox spacing="6.0" alignment="CENTER_LEFT">
        <Circle radius="3.0" styleClass="deco-dot-peach" />
        <Circle radius="3.0" styleClass="deco-dot-teal" />
        <Circle radius="3.0" styleClass="deco-dot" />
        <Rectangle width="40.0" height="1.0" fill="#b18db8" opacity="0.35" />
      </HBox>
    </VBox>
  </StackPane>

  <AnchorPane HBox.hgrow="ALWAYS" style="-fx-background-color: #FAFAF8;">
    <Circle radius="140.0" layoutX="100.0" layoutY="100.0" styleClass="deco-glow-purple" />
    <Circle radius="100.0" layoutX="200.0" layoutY="700.0" styleClass="deco-glow-peach" />

    <VBox alignment="CENTER" spacing="0"
      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
      style="-fx-padding: 0 80;">
      <VBox fx:id="loginForm" spacing="22.0" maxWidth="360.0">
        <Label text="WELCOME" styleClass="auth-form-title" />
        <Rectangle width="40.0" height="2.0" fill="#E2A998" />

        <VBox spacing="5.0">
          <Label text="EMAIL ADDRESS" styleClass="field-label" />
          <TextField fx:id="loginEmail" promptText="you@example.com" />
        </VBox>

        <VBox spacing="5.0">
          <Label text="PASSWORD" styleClass="field-label" />
          <PasswordField fx:id="loginPassword" promptText="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" />
        </VBox>

        <Label fx:id="loginError" styleClass="auth-error" managed="false" visible="false" wrapText="true" />

        <Button text="SIGN  IN" onAction="#handleLogin" styleClass="btn btn-primary" maxWidth="Infinity" style="-fx-padding: 15 32;" />

        <HBox alignment="CENTER" spacing="5.0" style="-fx-padding: 4 0 0 0;">
          <Label text="New to Velmora?" styleClass="auth-switch-text" />
          <Hyperlink text="Create an account" onAction="#switchToRegister" styleClass="auth-switch-link" />
        </HBox>
      </VBox>

      <VBox fx:id="registerForm" spacing="18.0" maxWidth="360.0" managed="false" visible="false">
        <Label text="CREATE ACCOUNT" styleClass="auth-form-title" />
        <Rectangle width="40.0" height="2.0" fill="#b18db8" />

        <VBox spacing="5.0">
          <Label text="NICKNAME" styleClass="field-label" />
          <TextField fx:id="regNickname" promptText="Your perfumer alias" />
        </VBox>

        <VBox spacing="5.0">
          <Label text="EMAIL ADDRESS" styleClass="field-label" />
          <TextField fx:id="regEmail" promptText="you@example.com" />
        </VBox>

        <VBox spacing="5.0">
          <Label text="PASSWORD" styleClass="field-label" />
          <PasswordField fx:id="regPassword" promptText="At least 6 characters" />
        </VBox>

        <Label fx:id="regError" styleClass="auth-error" managed="false" visible="false" wrapText="true" />

        <Button text="CREATE  ACCOUNT" onAction="#handleRegister" styleClass="btn btn-teal" maxWidth="Infinity" style="-fx-padding: 15 32;" />

        <HBox alignment="CENTER" spacing="5.0">
          <Label text="Already have an account?" styleClass="auth-switch-text" />
          <Hyperlink text="Sign in" onAction="#switchToLogin" styleClass="auth-switch-link" />
        </HBox>
      </VBox>

      <VBox fx:id="verifyForm" spacing="22.0" maxWidth="360.0" managed="false" visible="false">
        <Label text="VERIFY EMAIL" styleClass="auth-form-title" />
        <Rectangle width="40.0" height="2.0" fill="#E2A998" />

        <Label fx:id="verifyInfoText" text="We sent a 6-digit code to your email address."
          wrapText="true" style=" -fx-font-size: 19; -fx-font-style: italic; -fx-text-fill: #A0968C;" />

        <VBox spacing="5.0">
          <Label text="VERIFICATION CODE" styleClass="field-label" />
          <TextField fx:id="verifyCode" promptText="0 0 0 0 0 0" alignment="CENTER"
            style="-fx-font-family: 'Garamond', 'Georgia', serif; -fx-font-size: 34;
                   -fx-font-weight: bold; -fx-letter-spacing: 14; -fx-text-fill: #1C1917;" />
        </VBox>

        <Label fx:id="verifyError" styleClass="auth-error" managed="false" visible="false" wrapText="true" />

        <Button text="VERIFY  EMAIL" onAction="#handleVerify" styleClass="btn btn-peach" maxWidth="Infinity" style="-fx-padding: 15 32;" />

        <HBox alignment="CENTER" spacing="5.0">
          <Label text="Back to" styleClass="auth-switch-text" />
          <Hyperlink text="Sign in" onAction="#switchToLogin" styleClass="auth-switch-link" />
        </HBox>
      </VBox>
    </VBox>

    <VBox alignment="BOTTOM_RIGHT" style="-fx-padding: 28;"
      AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <HBox spacing="6.0">
        <Circle radius="3.0" styleClass="deco-dot" />
        <Circle radius="3.0" styleClass="deco-dot-teal" />
        <Circle radius="3.0" styleClass="deco-dot-peach" />
      </HBox>
    </VBox>
  </AnchorPane>
</HBox>
