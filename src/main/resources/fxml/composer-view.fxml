<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.GaussianBlur?>

<AnchorPane prefHeight="800.0" prefWidth="1180.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="velmora.composer.ui.controller.ComposerController"
            styleClass="composer-root">

  <!-- ═══ LEFT PANEL — Material Library (380px) ═══ -->
  <AnchorPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              prefWidth="380.0" minWidth="380.0" maxWidth="380.0"
              style="-fx-background-color: transparent;">
    <VBox AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
      <VBox style="-fx-padding: 28 20 12 24;" spacing="2.0">
        <HBox spacing="8.0" alignment="CENTER_LEFT">
          <Rectangle width="20.0" height="1.0" fill="#C4BFB9" />
          <Label text="MATERIAL LIBRARY" styleClass="section-sub" />
        </HBox>
        <Label text="Raw Materials" styleClass="composer-heading" />
        <HBox alignment="CENTER_RIGHT">
          <Label fx:id="materialCount" text="0 materials"
                 style="-fx-font-size: 10; -fx-text-fill: #B0ADA8; -fx-font-style: italic;" />
        </HBox>
      </VBox>

      <HBox spacing="6.0" style="-fx-padding: 0 20 14 24;">
        <Button text="ALL"   styleClass="filter-pill" fx:id="filterAll" />
        <Button text="TOP"   styleClass="filter-pill" fx:id="filterTop" />
        <Button text="HEART" styleClass="filter-pill" fx:id="filterHeart" />
        <Button text="BASE"  styleClass="filter-pill" fx:id="filterBase" />
      </HBox>

      <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;"
                  styleClass="thin-scroll">
        <ListView fx:id="materialsList" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-padding: 0;"
                  styleClass="thin-scroll" />
      </ScrollPane>

      <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="selected-bar" minHeight="40.0" prefHeight="40.0" maxHeight="40.0">
        <Label text="SELECTED" styleClass="section-sub" />
        <Label fx:id="selectedCount" text="0"
               style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #A4A0C5;" />
      </HBox>
    </VBox>
  </AnchorPane>

  <!-- ═══ CENTER — Atmospheric Molecular Field + Pyramid + Analysis ═══ -->
  <AnchorPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="380.0" AnchorPane.rightAnchor="340.0"
              style="-fx-background-color: transparent;">

    <Circle radius="360.0" layoutX="300.0" layoutY="320.0" styleClass="mol-ambient" />
    <Circle radius="320.0" layoutX="300.0" layoutY="300.0" styleClass="mol-glow-top" />
    <Circle radius="260.0" layoutX="280.0" layoutY="380.0" styleClass="mol-glow-heart" />
    <Circle radius="300.0" layoutX="320.0" layoutY="460.0" styleClass="mol-glow-base" />

    <Pane fx:id="particleLayer" mouseTransparent="true" />

    <HBox AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" styleClass="composer-header"
          alignment="CENTER_LEFT" spacing="12.0">
      <Rectangle width="3.0" height="18.0" fill="#E2A998" arcWidth="2" arcHeight="2" />
      <TextField fx:id="formulaName"
                 promptText="Untitled Formula"
                 styleClass="formula-field" />
      <Label fx:id="formulaStatus" text="" styleClass="status-badge" />
      <Region HBox.hgrow="ALWAYS" />
      <Button text="SAVE" onAction="#handleSave" styleClass="btn-save" />
      <Button text="EXPORT" onAction="#handleExport" styleClass="btn-ghost-lux" />
    </HBox>

    <VBox AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="62.0" AnchorPane.bottomAnchor="230.0"
          alignment="CENTER" spacing="14.0" style="-fx-padding: 16 40;">

      <VBox styleClass="zone-floating, zone-floating-top" fx:id="topZone"
            maxWidth="380.0" minHeight="60.0">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
          <Circle radius="5.0" style="-fx-fill: rgba(226,169,152,0.8);" />
          <Label text="TOP NOTES" styleClass="zone-label" />
          <Region HBox.hgrow="ALWAYS" />
          <Label fx:id="topCount" text="0" styleClass="zone-count" />
        </HBox>
        <FlowPane fx:id="topChips" hgap="6" vgap="6" style="-fx-padding: 6 0 0 0;" />
        <Label text="Drag ingredients here" styleClass="zone-placeholder" />
      </VBox>

      <VBox styleClass="zone-floating, zone-floating-heart" fx:id="heartZone"
            maxWidth="380.0" minHeight="60.0">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
          <Circle radius="5.0" style="-fx-fill: rgba(164,160,197,0.8);" />
          <Label text="HEART NOTES" styleClass="zone-label" />
          <Region HBox.hgrow="ALWAYS" />
          <Label fx:id="heartCount" text="0" styleClass="zone-count" />
        </HBox>
        <FlowPane fx:id="heartChips" hgap="6" vgap="6" style="-fx-padding: 6 0 0 0;" />
        <Label text="Drag ingredients here" styleClass="zone-placeholder" />
      </VBox>

      <VBox styleClass="zone-floating, zone-floating-base" fx:id="baseZone"
            maxWidth="380.0" minHeight="60.0">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
          <Circle radius="5.0" style="-fx-fill: rgba(120,160,160,0.8);" />
          <Label text="BASE NOTES" styleClass="zone-label" />
          <Region HBox.hgrow="ALWAYS" />
          <Label fx:id="baseCount" text="0" styleClass="zone-count" />
        </HBox>
        <FlowPane fx:id="baseChips" hgap="6" vgap="6" style="-fx-padding: 6 0 0 0;" />
        <Label text="Drag ingredients here" styleClass="zone-placeholder" />
      </VBox>
    </VBox>

    <VBox AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0"
          AnchorPane.bottomAnchor="0.0"
          prefHeight="270.0" styleClass="insight-panel"
          spacing="6.0">
      <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Circle radius="3.0" style="-fx-fill: rgba(164,160,197,0.6);" />
        <Label text="COMPOSITION INSIGHTS" styleClass="section-sub" />
      </HBox>

      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-padding: 0;"
                  styleClass="thin-scroll">
        <VBox fx:id="insightsContainer" spacing="6.0"
              style="-fx-padding: 4 0 4 0;">
          <Label text="Add at least 2 notes to see analysis"
                 style="-fx-font-size: 11; -fx-font-style: italic; -fx-text-fill: #B0ADA8;" />
        </VBox>
      </ScrollPane>
    </VBox>
  </AnchorPane>

  <!-- ═══ RIGHT PANEL — Live Analysis ═══ -->
  <AnchorPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              prefWidth="340.0"
              style="-fx-background-color: transparent;">
    <VBox AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
      <VBox style="-fx-padding: 28 24 16 24;" spacing="3.0">
        <HBox spacing="8.0" alignment="CENTER_LEFT">
          <Rectangle width="20.0" height="1.0" fill="#C4BFB9" />
          <Label text="LIVE ANALYSIS" styleClass="section-sub" />
        </HBox>
        <Label text="Olfactory Data" styleClass="composer-heading" />
      </VBox>

      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-padding: 0 8 0 12;"
                  styleClass="thin-scroll">
        <VBox spacing="14.0" style="-fx-padding: 4 12 28 12;">

          <VBox styleClass="analysis-glass" spacing="12.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
              <Circle radius="3.0" style="-fx-fill: rgba(90,158,143,0.7);" />
              <Label text="PERFORMANCE" styleClass="section-sub" />
            </HBox>
            <VBox spacing="6.0">
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label text="Harmony" styleClass="perf-label" prefWidth="70" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="harmonyBar" width="0" height="4.0" styleClass="perf-fill-teal" />
                </StackPane>
                <Label fx:id="harmonyScore" text="—" styleClass="perf-value" />
              </HBox>
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label text="Longevity" styleClass="perf-label" prefWidth="70" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="longevityBar" width="0" height="4.0" styleClass="perf-fill-peach" />
                </StackPane>
                <Label fx:id="longevityScore" text="—" styleClass="perf-value" />
              </HBox>
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label text="Complexity" styleClass="perf-label" prefWidth="70" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="complexityBar" width="0" height="4.0" styleClass="perf-fill-purple" />
                </StackPane>
                <Label fx:id="complexityScore" text="—" styleClass="perf-value" />
              </HBox>
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label text="Projection" styleClass="perf-label" prefWidth="70" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="projectionBar" width="0" height="4.0" styleClass="perf-fill-teal" />
                </StackPane>
                <Label fx:id="projectionScore" text="—" styleClass="perf-value" />
              </HBox>
            </VBox>
          </VBox>

          <VBox styleClass="analysis-glass" spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
              <Circle radius="3.0" style="-fx-fill: rgba(164,160,197,0.7);" />
              <Label text="FAMILY DISTRIBUTION" styleClass="section-sub" />
            </HBox>
            <VBox spacing="6.0">
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Circle radius="3.0" style="-fx-fill: rgba(226,169,152,0.8);" />
                <Label text="Citrus" styleClass="fam-label" prefWidth="50" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="citrusBar" width="0" height="4.0" fill="rgba(226,169,152,0.7)" styleClass="fam-fill" />
                </StackPane>
                <Label fx:id="citrusPct" text="0%" styleClass="fam-pct" prefWidth="32" />
              </HBox>
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Circle radius="3.0" style="-fx-fill: rgba(164,160,197,0.8);" />
                <Label text="Floral" styleClass="fam-label" prefWidth="50" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="floralBar" width="0" height="4.0" fill="rgba(164,160,197,0.7)" styleClass="fam-fill" />
                </StackPane>
                <Label fx:id="floralPct" text="0%" styleClass="fam-pct" prefWidth="32" />
              </HBox>
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Circle radius="3.0" style="-fx-fill: rgba(120,160,160,0.8);" />
                <Label text="Woody" styleClass="fam-label" prefWidth="50" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="woodyBar" width="0" height="4.0" fill="rgba(120,160,160,0.7)" styleClass="fam-fill" />
                </StackPane>
                <Label fx:id="woodyPct" text="0%" styleClass="fam-pct" prefWidth="32" />
              </HBox>
              <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Circle radius="3.0" style="-fx-fill: rgba(90,158,143,0.8);" />
                <Label text="Earthy" styleClass="fam-label" prefWidth="50" />
                <StackPane HBox.hgrow="ALWAYS" prefHeight="6.0">
                  <Rectangle width="Infinity" height="4.0" styleClass="perf-track" />
                  <Rectangle fx:id="earthyBar" width="0" height="4.0" fill="rgba(90,158,143,0.7)" styleClass="fam-fill" />
                </StackPane>
                <Label fx:id="earthyPct" text="0%" styleClass="fam-pct" prefWidth="32" />
              </HBox>
            </VBox>
          </VBox>

          <VBox styleClass="analysis-glass" spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
              <Circle radius="3.0" style="-fx-fill: rgba(226,169,152,0.7);" />
              <Label text="FORMULA METRICS" styleClass="section-sub" />
            </HBox>
            <VBox spacing="8.0">
              <HBox spacing="8.0">
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard" alignment="CENTER">
                  <Label fx:id="noteCount" text="0" styleClass="mcard-value" />
                  <Label text="NOTES" styleClass="mcard-label" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard" alignment="CENTER">
                  <Label fx:id="familyCount" text="0" styleClass="mcard-value" />
                  <Label text="FAMILIES" styleClass="mcard-label" />
                </VBox>
              </HBox>
              <HBox spacing="8.0">
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard" alignment="CENTER">
                  <Label fx:id="estLongevity" text="—" styleClass="mcard-value" />
                  <Label text="LONGEVITY" styleClass="mcard-label" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard" alignment="CENTER">
                  <Label fx:id="sillage" text="—" styleClass="mcard-value" />
                  <Label text="SILLAGE" styleClass="mcard-label" />
                </VBox>
              </HBox>
              <Rectangle width="Infinity" height="1.0" style="-fx-fill: rgba(221,217,209,0.3);" />
              <Label text="PHASE LONGEVITY" style="-fx-font-size: 9; -fx-text-fill: #A8A29E; -fx-letter-spacing: 1; -fx-font-weight: 600;" />
              <HBox spacing="6.0">
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard-sm" alignment="CENTER">
                  <Label fx:id="topDuration" text="—" styleClass="mcard-value-sm" />
                  <Label text="TOP" styleClass="mcard-label" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard-sm" alignment="CENTER">
                  <Label fx:id="heartDuration" text="—" styleClass="mcard-value-sm" />
                  <Label text="HEART" styleClass="mcard-label" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard-sm" alignment="CENTER">
                  <Label fx:id="baseDuration" text="—" styleClass="mcard-value-sm" />
                  <Label text="BASE" styleClass="mcard-label" />
                </VBox>
              </HBox>
              <HBox spacing="8.0">
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard" alignment="CENTER">
                  <Label fx:id="totalIntensity" text="0" styleClass="mcard-value" />
                  <Label text="INTENSITY" styleClass="mcard-label" />
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="mcard" alignment="CENTER">
                  <Label fx:id="moleculeCount" text="0" styleClass="mcard-value" />
                  <Label text="MOLECULES" styleClass="mcard-label" />
                </VBox>
              </HBox>
              <VBox styleClass="mcard" alignment="CENTER" maxWidth="Infinity">
                <Label fx:id="overallScore" text="0" styleClass="mcard-value" />
                <Label text="OVERALL" styleClass="mcard-label" />
              </VBox>
            </VBox>
          </VBox>
        </VBox>
      </ScrollPane>
    </VBox>
  </AnchorPane>
</AnchorPane>
